{
  "name": "yandex-lms",
  "displayName": "Яндекс LMS",
  "description": "Полный доступ к LMS Яндекса (lms.yandex.ru) внутри VS Code: учебники и материалы уроков, условие слева, код справа, отправка решения одной клавишей, ИИ-помощник (API-ключи и OpenCode CLI)",
  "version": "2.8.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --out dist/"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "yandexLms.loginQr",
        "title": "Войти по QR-коду (телефон)",
        "category": "Яндекс LMS",
        "icon": "$(device-camera)"
      },
      {
        "command": "yandexLms.loginMenu",
        "title": "Вход (QR / пароль / cookie)",
        "category": "Яндекс LMS",
        "icon": "$(sign-in)"
      },
      {
        "command": "yandexLms.login",
        "title": "Войти (логин и пароль Яндекса)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.loginByCookie",
        "title": "Войти по cookie (если включена 2FA)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.logout",
        "title": "Выйти",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.refresh",
        "title": "Обновить список курсов",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.grades",
        "title": "Мои оценки (прогресс и баллы по курсу)",
        "category": "Яндекс LMS",
        "icon": "$(graph)"
      },
      {
        "command": "yandexLms.openTask",
        "title": "Открыть задание (условие + редактор)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.openMaterial",
        "title": "Читать материал урока",
        "category": "Яндекс LMS",
        "icon": "$(book)"
      },
      {
        "command": "yandexLms.openLessonMaterials",
        "title": "Материалы урока",
        "category": "Яндекс LMS",
        "icon": "$(book)"
      },
      {
        "command": "yandexLms.materialInBrowser",
        "title": "Открыть материал в браузере",
        "category": "Яндекс LMS",
        "icon": "$(link-external)"
      },
      {
        "command": "yandexLms.materialText",
        "title": "Материал — текстом",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.materialPanel",
        "title": "Материал — панелью",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.submit",
        "title": "Отправить решение на проверку",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.pullSolution",
        "title": "Забрать моё решение из LMS в файл",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.runLocal",
        "title": "Запустить решение локально (python)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.openInBrowser",
        "title": "Открыть задание в браузере",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.lens",
        "title": "Google Объектив: снимок задания",
        "category": "Яндекс LMS",
        "icon": "$(device-camera)"
      },
      {
        "command": "yandexLms.welcome",
        "title": "Как пользоваться",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.settings",
        "title": "Настройки",
        "category": "Яндекс LMS",
        "icon": "$(gear)"
      },
      {
        "command": "yandexLms.showLog",
        "title": "Показать лог",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.diagnose",
        "title": "Диагностика API",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.collect",
        "title": "Собрать отчёт для отладки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.taskMenu",
        "title": "Действия над задачей",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.refreshStatus",
        "title": "Обновить статус задачи",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.details",
        "title": "Подробности проверки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.pep8",
        "title": "Проверить код на PEP 8",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.answer",
        "title": "Ответить на задание (выбрать вариант)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.findImages",
        "title": "Найти задания с картинками (диагностика)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.showPanel",
        "title": "Условие — панелью",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.showText",
        "title": "Условие — текстом",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.fixWebview",
        "title": "Починить панель условия (перезагрузить webview)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.fixWebviewProfile",
        "title": "Починить webview (очистить Service Worker)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiHints",
        "title": "AI — подсказки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiSolve",
        "title": "AI — решение задачи",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiCheck",
        "title": "AI — проверить решение",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiFix",
        "title": "AI — исправить решение по ошибке проверки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiClear",
        "title": "AI — очистить подсказки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiForget",
        "title": "AI — забыть накопленные ошибки",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiSettings",
        "title": "AI — поведение (подсказки, правила курса)",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiKeys",
        "title": "AI — ключи и провайдеры",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiTest",
        "title": "AI — проверить подключение",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiOpencode",
        "title": "AI — подключить OpenCode CLI",
        "category": "Яндекс LMS"
      },
      {
        "command": "yandexLms.aiCline",
        "title": "AI — подключить Cline CLI",
        "category": "Яндекс LMS"
      }
    ],
    "keybindings": [
      {
        "command": "yandexLms.submit",
        "key": "ctrl+alt+s"
      },
      {
        "command": "yandexLms.openTask",
        "key": "ctrl+alt+t"
      },
      {
        "command": "yandexLms.lens",
        "key": "ctrl+alt+g"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "yandexLms.loginQr",
          "when": "view == yandexLms.tree",
          "group": "navigation@0"
        },
        {
          "command": "yandexLms.loginMenu",
          "when": "view == yandexLms.tree",
          "group": "navigation@1"
        },
        {
          "command": "yandexLms.refresh",
          "when": "view == yandexLms.tree",
          "group": "navigation@2"
        },
        {
          "command": "yandexLms.welcome",
          "when": "view == yandexLms.tree",
          "group": "navigation@3"
        },
        {
          "command": "yandexLms.settings",
          "when": "view == yandexLms.tree",
          "group": "navigation@4"
        },
        {
          "command": "yandexLms.grades",
          "when": "view == yandexLms.tree",
          "group": "1_progress@0"
        }
      ],
      "view/item/context": [
        {
          "command": "yandexLms.grades",
          "when": "view == yandexLms.tree && viewItem == lmsCourse",
          "group": "lms@0"
        },
        {
          "command": "yandexLms.loginQr",
          "when": "view == yandexLms.tree",
          "group": "lms@1"
        },
        {
          "command": "yandexLms.openLessonMaterials",
          "when": "view == yandexLms.tree && viewItem == lmsLesson",
          "group": "lms@2"
        },
        {
          "command": "yandexLms.openMaterial",
          "when": "view == yandexLms.tree && viewItem == lmsMaterial",
          "group": "lms@2"
        },
        {
          "command": "yandexLms.materialInBrowser",
          "when": "view == yandexLms.tree && viewItem == lmsMaterial",
          "group": "lms@3"
        },
        {
          "command": "yandexLms.submit",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@11"
        },
        {
          "command": "yandexLms.refreshStatus",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@102"
        },
        {
          "command": "yandexLms.aiHints",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@103"
        },
        {
          "command": "yandexLms.aiCheck",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@104"
        },
        {
          "command": "yandexLms.aiSolve",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@105"
        },
        {
          "command": "yandexLms.aiClear",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@106"
        },
        {
          "command": "yandexLms.openInBrowser",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@107"
        },
        {
          "command": "yandexLms.aiFix",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@108"
        },
        {
          "command": "yandexLms.aiKeys",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@112"
        },
        {
          "command": "yandexLms.settings",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@113"
        },
        {
          "command": "yandexLms.details",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@109"
        },
        {
          "command": "yandexLms.pep8",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@110"
        },
        {
          "command": "yandexLms.answer",
          "when": "view == yandexLms.tree && viewItem == lmsTask",
          "group": "lms@111"
        }
      ]
    },
    "configuration": {
      "title": "Яндекс LMS",
      "properties": {
        "yandexLms.apiBase": {
          "type": "string",
          "default": "https://lms.yandex.ru",
          "description": "Адрес LMS (обычно менять не нужно)"
        },
        "yandexLms.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Команда запуска Python для локального теста и PEP 8"
        },
        "yandexLms.folderName": {
          "type": "string",
          "default": "yandex-lms",
          "description": "Имя папки внутри рабочей области, куда складывать решения"
        },
        "yandexLms.pollSeconds": {
          "type": "number",
          "default": 60,
          "description": "Сколько секунд ждать вердикт проверки после отправки"
        },
        "yandexLms.taskView": {
          "type": "string",
          "enum": [
            "panel",
            "text",
            "auto"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Панель условия (webview, с кнопками)",
            "Условие текстом + preview VS Code (надёжно, но без кнопок)",
            "Авто: сначала панель, при неудаче текст"
          ],
          "description": "Как показывать условие задачи"
        },
        "yandexLms.debug": {
          "type": "boolean",
          "default": false,
          "description": "Отладка: писать логи (запросы к ИИ, отправка, webview) в %TEMP%\\yandex-lms-diag. Не включайте без необходимости — туда попадают условия задач и ваш код"
        },
        "yandexLms.ai.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Температура генерации подсказок"
        },
        "yandexLms.ai.opencodeBin": {
          "type": "string",
          "default": "opencode",
          "description": "Команда/путь к OpenCode CLI (по умолчанию «opencode» из PATH)"
        },
        "yandexLms.ai.clineBin": {
          "type": "string",
          "default": "cline",
          "description": "Команда/путь к Cline CLI (по умолчанию «cline» из PATH)"
        },
        "yandexLms.ai.courseRules": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Правила курса для ИИ (что разрешено/запрещено ученику). Пусто — встроенные правила базового курса «Программирование на Python»"
        },
        "yandexLms.ai.autocomplete": {
          "type": "boolean",
          "default": true,
          "description": "ИИ-автодополнение в редакторе: подсказывает следующую строку решения по условию задачи"
        },
        "yandexLms.ai.autocompleteDelay": {
          "type": "number",
          "default": 800,
          "description": "Задержка (мс) перед запросом подсказки к ИИ"
        },
        "yandexLms.ai.autocompleteMaxCalls": {
          "type": "number",
          "default": 12,
          "description": "Максимум запросов к ИИ в минуту для автодополнения"
        },
        "yandexLms.ai.selfCheck": {
          "type": "boolean",
          "default": true,
          "description": "Самопроверка кода ИИ перед вставкой: запрещённые в курсе конструкции и компиляция Python, с автоисправлением"
        },
        "yandexLms.ai.hedge": {
          "type": "boolean",
          "default": true,
          "description": "Ускорение: если первый ключ/модель тормозит, параллельно запрашивать следующий (кто ответит первым — тот и используется)"
        },
        "yandexLms.ai.hedgeDelay": {
          "type": "number",
          "default": 7000,
          "description": "Через сколько миллисекунд ожидания запускать параллельный запрос ко второму ключу"
        },
        "yandexLms.ai.retries": {
          "type": "number",
          "default": 3,
          "description": "Сколько ключей из пула пробовать за один запрос, прежде чем сдаться"
        },
        "yandexLms.lens.openIn": {
          "type": "string",
          "enum": [
            "browser",
            "panel"
          ],
          "default": "browser",
          "enumDescriptions": [
            "Открыть результат в браузере по умолчанию",
            "Показать снимок и ссылку в панели VS Code (Google не даёт встраивать страницу результатов)"
          ],
          "description": "Куда открывать результат Google Объектива"
        },
        "yandexLms.lens.scale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "Качество снимка условия для Объектива (масштаб растрирования, 1–3)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yandexLms",
          "title": "Яндекс LMS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "yandexLms": [
        {
          "id": "yandexLms.tree",
          "name": "Курсы и задания"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mawwki/yandex-lms-vscode.git"
  },
  "keywords": [
    "lms",
    "yandex",
    "education",
    "python",
    "vscode-extension",
    "ai",
    "tutor"
  ],
  "homepage": "https://github.com/mawwki/yandex-lms-vscode#readme",
  "bugs": {
    "url": "https://github.com/mawwki/yandex-lms-vscode/issues"
  }
}
